    </link>

    <joint name="wrist_2_joint" type="fixed">
      <origin rpy="0.00000 0.00000 0.00000" xyz="-0.75000 0.00000 0.00000"/>
      <parent link="arm_1_link"/>
      <child link="wrist_2_link"/>
    </joint>

    <link name="wrist_2_link">
      <collision name="wrist_2_collision">
        <geometry>
          <cylinder radius="0.20000" length="0.35000"/>
