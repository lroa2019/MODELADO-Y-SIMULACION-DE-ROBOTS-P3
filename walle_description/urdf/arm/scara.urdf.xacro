    <joint name="arm_3_joint" type="prismatic">
      <limit lower="-2.60000" upper="0.00000" effort="5000.0" velocity="500.0"/>
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.97704"/>
      <parent link="wrist_5_link"/>
      <child link="arm_3_link"/>
